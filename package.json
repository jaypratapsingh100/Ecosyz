{
  "name": "openidea",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "vitest",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev --name profile_init",
    "dev:full": "concurrently \"npm run dev\" \"npm run db:studio\"",
    "vercel-build": "prisma generate && next build",
    "test-auth": "node test-local-auth.js",
    "dev-test": "npm run dev & sleep 5 && npm run test-auth"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@octokit/rest": "^22.0.0",
    "@paypal/react-paypal-js": "^8.9.1",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/cytoscape": "^3.21.9",
    "@types/next-auth": "^3.13.0",
    "@types/qrcode.react": "^1.0.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@upstash/redis": "^1.35.5",
    "@vercel/kv": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.33.1",
    "framer-motion": "^12.23.15",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "next": "15.3.5",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "openai": "^6.2.0",
    "pdf-parse": "^1.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.63.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.9"
