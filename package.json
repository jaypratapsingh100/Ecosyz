{
  "name": "openidea",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start -H localhost",
    "lint": "next lint",
    "format": "prettier --write .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev --name profile_init",
    "db:migrate:vercel": "bash scripts/migrate.sh",
    "dev:full": "concurrently \"pnpm dev\" \"pnpm db:studio\"",
    "vercel-build": "prisma generate && next build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.16.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/next-auth": "^3.13.0",
    "@types/qrcode.react": "^1.0.5",
    "@types/react-split-pane": "^0.1.67",
    "@vercel/kv": "^3.0.0",
    "clsx": "^2.1.1",
    "cytoscape": "^3.32.0",
    "esbuild": "^0.27.2",
    "framer-motion": "^12.23.15",
    "jszip": "^3.10.1",
    "lucide-react": "^0.544.0",
    "monaco-editor": "^0.55.1",
    "neo4j-driver": "^5.20.0",
    "next": "^15.3.6",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "openai": "^6.10.0",
    "pdf-parse": "^1.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.63.0",
    "react-markdown": "^10.1.0",
    "react-split-pane": "^0.1.92",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^15.3.6",
    "prisma": "^6.16.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "license": "AGPL-3.0"
}
