// Prisma schema for Basic Project Workspace

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                @id @default(cuid())
  supabaseId            String                @unique
  email                 String                @unique
  name                  String?
  avatarUrl             String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  workspaces            Workspace[]
  profile               Profile?
  subscriptionPlan      String?
  subscriptionStatus    String?
  subscriptionStartDate DateTime?
  lastPaymentAmount     Float?
  lastPaymentId         String?
  lastPaymentDate       DateTime?
  appProjects           AppProject[]
  // Community relations
  groupMembers          GroupMember[]
  createdGroups         CommunityGroup[]      @relation("GroupCreator")
  discussions           Discussion[]
  discussionReplies     DiscussionReply[]
  createdEvents         Event[]
  eventRegistrations    EventRegistration[]
  createdChallenges     Challenge[]
  challengeSubmissions  ChallengeSubmission[]
  following             UserFollow[]          @relation("UserFollowing")
  followers             UserFollow[]          @relation("UserFollowers")
  activities            Activity[]
  pageVisits            PageVisit[]
  searchLogs            SearchLog[]
  resourceViews         ResourceView[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  bio         String?  @db.Text
  avatarUrl   String?
  preferences Json? // { theme: "system"|"light"|"dark", language: "en-IN", emailNotifications: boolean, marketingEmails: boolean }
  
  // Enhanced Profile Fields
  location        String?  // City, Country
  affiliation     String?  // University, Company, Organization
  website         String?  // Personal website URL
  expertiseTags   String[] // Array of expertise areas (e.g., ["machine-learning", "climate-science", "open-source"])
  
  // External Integrations
  orcidId         String?  @unique // ORCID identifier for researchers
  githubUsername  String?  // GitHub username
  linkedinUrl     String?  // LinkedIn profile URL
  twitterHandle   String?  // Twitter/X handle
  
  // Contribution Stats (computed fields, updated via triggers or background jobs)
  projectsCreated     Int @default(0)
  resourcesShared     Int @default(0)
  discussionsStarted  Int @default(0)
  discussionsReplied  Int @default(0)
  groupsCreated       Int @default(0)
  eventsCreated       Int @default(0)
  challengesCreated   Int @default(0)
  
  // Reputation & Achievements
  reputationScore     Float @default(0) // Calculated reputation score
  achievementBadges   String[] // Array of badge IDs earned
  
  // Metadata
  lastActivityAt      DateTime? // Last activity timestamp
  profileCompleted   Boolean @default(false) // Whether profile is fully set up
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([orcidId])
  @@index([githubUsername])
  @@index([reputationScore])
}

model Workspace {
  id          String       @id @default(cuid())
  title       String
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  resources   Resource[]
  shares      ShareLink[]
  appProjects AppProject[]
  discussions Discussion[]
  resourceViews ResourceView[]
}

model Resource {
  id          String       @id @default(cuid())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  title       String
  url         String?
  type        String?
  tags        Json?
  data        Json?
  createdAt   DateTime     @default(now())
  annotations Annotation[]
  views       ResourceView[]
}

model Annotation {
  id         String   @id @default(cuid())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String
  body       String
  highlights Json?
  createdAt  DateTime @default(now())
}

model ShareLink {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  token       String    @unique
  readOnly    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model AppProject {
  id               String         @id @default(cuid())
  title            String
  description      String?
  type             String         @default("web") // web, fullstack, other
  framework        String? // react, nextjs, python, etc.
  previewVersion   String         @default("v1") // v1 (legacy) | v2 (esbuild)
  ownerId          String
  owner            User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId      String?
  workspace        Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  config           Json? // Project configuration
  // Questionnaire data
  questionnaireData Json? // Complete questionnaire answers
  appType          String? // portfolio, business, ecommerce, saas, blog, landing, other
  targetAudience   String? // general, b2b, b2c, developers, students, other
  designStyle      String? // modern-minimal, bold-colorful, professional, creative, clean-simple
  colorScheme      String? // blue, orange-red, green-teal, purple, gray-black, custom, auto
  layoutStyle      String? // single-page, multi-page, dashboard, blog, landing
  requiredFeatures String[] // Array of required features
  brandName        String?
  tagline          String?
  keyPoints        String? @db.Text // Key points to highlight
  // Deployment fields
  deploymentUrl    String? // URL where the app is deployed
  deploymentStatus String? // pending, deployed, failed, building
  deploymentPlatform String? // coolify, vercel, render, github, static
  deploymentId     String? // Platform-specific deployment ID
  claimUrl         String? // Claimable deployment URL (for Vercel)
  deployedAt       DateTime? // When deployment completed
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
      files            AppFile[]
      images           AppImage[]
      chats            AppChat[]
      executions       AppExecution[]
}

model AppFile {
  id        String     @id @default(cuid())
  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String // File path within project (e.g., "src/App.jsx")
  name      String // File name (e.g., "App.jsx")
  content   String     @db.Text
  language  String? // Programming language (jsx, ts, py, etc.)
  isMain    Boolean    @default(false) // Is this the main entry file?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([projectId, path])
}

model AppImage {
  id        String     @id @default(cuid())
  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String     @db.Text // Image URL, base64 data, or SVG code
  name      String // Display name for the image
  type      String     @default("url") // url, base64, svg
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([projectId])
}

model AppChat {
  id        String     @id @default(cuid())
  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Json // Array of chat messages
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model AppExecution {
  id        String     @id @default(cuid())
  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    String // success, error, running
  output    String?    @db.Text
  error     String?    @db.Text
  createdAt DateTime   @default(now())
}

// Community Models

model CommunityGroup {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  slug        String        @unique
  isPublic    Boolean       @default(true)
  topics      String[] // Array of topic tags
  avatarUrl   String?
  bannerUrl   String?
  creatorId   String
  creator     User          @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  discussions Discussion[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([creatorId])
}

model GroupMember {
  id       String         @id @default(cuid())
  groupId  String
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String         @default("member") // member, moderator, admin
  joinedAt DateTime       @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model Discussion {
  id          String            @id @default(cuid())
  title       String
  content     String            @db.Text
  groupId     String?
  group       CommunityGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags        String[]
  isPinned    Boolean           @default(false)
  isLocked    Boolean           @default(false)
  replies     DiscussionReply[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([groupId])
  @@index([workspaceId])
  @@index([authorId])
  @@index([createdAt])
}

model DiscussionReply {
  id           String     @id @default(cuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  content      String     @db.Text
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([discussionId])
  @@index([authorId])
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String              @db.Text
  startDate     DateTime
  endDate       DateTime?
  location      String? // Physical location or "Online"
  eventUrl      String? // Link to event (Zoom, etc.)
  imageUrl      String?
  category      String? // workshop, webinar, hackathon, meetup, etc.
  maxAttendees  Int?
  isPublic      Boolean             @default(true)
  creatorId     String
  creator       User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([startDate])
  @@index([creatorId])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("registered") // registered, cancelled, attended
  registeredAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

model Challenge {
  id           String                @id @default(cuid())
  title        String
  description  String                @db.Text
  requirements String?               @db.Text
  prize        String? // Prize description
  startDate    DateTime
  endDate      DateTime
  imageUrl     String?
  category     String? // innovation, coding, research, etc.
  status       String                @default("upcoming") // upcoming, active, ended, judging, completed
  creatorId    String
  creator      User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  submissions  ChallengeSubmission[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status])
  @@index([endDate])
  @@index([creatorId])
}

model ChallengeSubmission {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  url         String? // Link to submission (GitHub, demo, etc.)
  status      String    @default("submitted") // submitted, shortlisted, winner, rejected
  submittedAt DateTime  @default(now())

  @@unique([challengeId, userId])
  @@index([userId])
  @@index([challengeId])
  @@index([status])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // discussion_created, reply_added, group_joined, event_registered, challenge_submitted, etc.
  entityType  String? // discussion, group, event, challenge, etc.
  entityId    String?
  title       String?
  description String?  @db.Text
  metadata    Json? // Additional data
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

// Analytics Tracking Models

model PageVisit {
  id        String   @id @default(cuid())
  userId    String?  // Nullable for anonymous visits
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path      String
  referrer  String?
  userAgent String?
  ipAddress String?
  sessionId String?  // For tracking sessions
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
}

model SearchLog {
  id              String   @id @default(cuid())
  userId          String?  // Nullable for anonymous searches
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query           String
  resourceType    String?  // paper, code, model, etc.
  resultCount     Int
  clicked         Boolean  @default(false)
  clickedResourceId String?
  providers       String[] // Which providers were queried
  sessionId       String?  // For tracking sessions
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([query])
  @@index([sessionId])
}

model ResourceView {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String?  // Nullable for anonymous views
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  sessionId  String?  // For tracking sessions
  createdAt  DateTime @default(now())

  @@index([resourceId])
  @@index([userId])
  @@index([createdAt])
  @@index([sessionId])
}
