// Prisma schema for Basic Project Workspace

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String                    @id @default(cuid())
  supabaseId               String                    @unique
  email                    String                    @unique
  name                     String?
  avatarUrl                String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  workspaces               Workspace[]
  profile                  Profile?
  subscriptionPlan         String?
  subscriptionStatus       String?
  subscriptionStartDate    DateTime?
  subscriptionEndDate      DateTime?
  lastPaymentAmount        Float?
  lastPaymentId            String?
  lastPaymentDate          DateTime?
  referredByAffiliateCode  String?   // Affiliate code used at subscription
  trialStartDate           DateTime?
  trialEndDate             DateTime?
  stripeCustomerId         String?   @unique
  // Credits system
  creditBalance            Float                     @default(0)
  creditsAllocated         Float                     @default(0)
  creditsUsed              Float                     @default(0)
  payments                 Payment[]
  appProjects              AppProject[]
  // Community relations
  groupMembers             GroupMember[]
  createdGroups            CommunityGroup[]          @relation("GroupCreator")
  discussions              Discussion[]
  discussionReplies        DiscussionReply[]
  createdEvents            Event[]
  eventRegistrations       EventRegistration[]
  createdChallenges        Challenge[]
  challengeSubmissions     ChallengeSubmission[]
  following                UserFollow[]              @relation("UserFollowing")
  followers                UserFollow[]              @relation("UserFollowers")
  activities               Activity[]
  pageVisits               PageVisit[]
  searchLogs               SearchLog[]
  resourceViews            ResourceView[]
  problemIdeaPosts         ProblemIdeaPost[]
  problemIdeaComments      ProblemIdeaComment[]
  problemIdeaPostLikes     ProblemIdeaPostLike[]
  problemIdeaCommentLikes  ProblemIdeaCommentLike[]
  savedNews                SavedNews[]
  barterAsks               BarterAsk[]
  barterPitches            BarterPitch[]
  gigs                     Gig[]
  gigRequests              GigRequest[]
  appProjectUpvotes        AppProjectUpvote[]
  conversationParticipants ConversationParticipant[] @relation("UserConversationParticipants")
  conversationMessages     ConversationMessage[]     @relation("UserConversationMessages")
  internFellow             InternFellow?
}

model Profile {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String?
  bio               String? @db.Text
  avatarUrl         String?
  portfolioImageUrl String?
  preferences       Json?

  // Enhanced Profile Fields
  location      String?
  affiliation   String?
  website       String?
  expertiseTags String[]
  primaryRole   String?
  roles         String[]

  // Deeper "about" fields
  headline     String? @db.Text
  currentFocus String? @db.Text
  lookingFor   String? @db.Text
  canHelpWith  String? @db.Text

  // Founder-specific fields
  startupName        String?
  startupStage       String?
  startupSector      String?
  startupDescription String? @db.Text

  // Researcher-specific fields
  researchField        String?
  researchInstitution  String?
  researchSummary      String? @db.Text
  selectedPublications String? @db.Text

  // External Integrations
  orcidId        String? @unique
  githubUsername String?
  linkedinUrl    String?
  twitterHandle  String?

  // Contribution Stats
  projectsCreated    Int @default(0)
  resourcesShared    Int @default(0)
  discussionsStarted Int @default(0)
  discussionsReplied Int @default(0)
  groupsCreated      Int @default(0)
  eventsCreated      Int @default(0)
  challengesCreated  Int @default(0)

  // Reputation & Achievements
  reputationScore   Float    @default(0)
  achievementBadges String[]

  // Metadata
  lastActivityAt   DateTime?
  profileCompleted Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orcidId])
  @@index([githubUsername])
  @@index([reputationScore])
}

model Workspace {
  id            String         @id @default(cuid())
  title         String
  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  resources     Resource[]
  shares        ShareLink[]
  appProjects   AppProject[]
  discussions   Discussion[]
  resourceViews ResourceView[]
}

model Resource {
  id          String         @id @default(cuid())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  title       String
  url         String?
  type        String?
  tags        Json?
  data        Json?
  createdAt   DateTime       @default(now())
  annotations Annotation[]
  views       ResourceView[]

  // Plagiarism check fields
  plagiarismScore  Float?
  plagiarismStatus String?
  plagiarismMeta   Json?
}

model Annotation {
  id         String   @id @default(cuid())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String
  body       String
  highlights Json?
  createdAt  DateTime @default(now())
}

model ShareLink {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  token       String    @unique
  readOnly    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model AppProject {
  id                 String             @id @default(cuid())
  title              String
  description        String?
  type               String             @default("web")
  framework          String?
  previewVersion     String             @default("v1")
  ownerId            String
  owner              User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  thumbnailUrl       String?
  isPublic           Boolean            @default(false)
  workspaceId        String?
  workspace          Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  config             Json?
  questionnaireData  Json?
  appType            String?
  targetAudience     String?
  designStyle        String?
  colorScheme        String?
  layoutStyle        String?
  requiredFeatures   String[]
  brandName          String?
  tagline            String?
  keyPoints          String?            @db.Text
  deploymentUrl      String?
  deploymentStatus   String?
  deploymentPlatform String?
  deploymentId       String?
  claimUrl           String?
  deployedAt         DateTime?
  generationState    Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  files              AppFile[]
  images             AppImage[]
  chats              AppChat[]
  executions         AppExecution[]
  appProjectUpvotes  AppProjectUpvote[]
  generationLogs     GenerationLog[]
}

model AppProjectUpvote {
  id        String     @id @default(cuid())
  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model AppFile {
  id        String     @id @default(cuid())
  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  name      String
  content   String     @db.Text
  language  String?
  isMain    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([projectId, path])
}

model AppImage {
  id        String     @id @default(cuid())
  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String     @db.Text
  name      String
  type      String     @default("url")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([projectId])
}

model AppChat {
  id        String     @id @default(cuid())
  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Json
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model AppExecution {
  id        String     @id @default(cuid())
  projectId String
  project   AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    String
  output    String?    @db.Text
  error     String?    @db.Text
  createdAt DateTime   @default(now())
}

// Community Models

model CommunityGroup {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  slug        String        @unique
  isPublic    Boolean       @default(true)
  topics      String[]
  avatarUrl   String?
  bannerUrl   String?
  creatorId   String
  creator     User          @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  discussions Discussion[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([creatorId])
}

model GroupMember {
  id       String         @id @default(cuid())
  groupId  String
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String         @default("member")
  joinedAt DateTime       @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model Discussion {
  id          String            @id @default(cuid())
  title       String
  content     String            @db.Text
  groupId     String?
  group       CommunityGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags        String[]
  isPinned    Boolean           @default(false)
  isLocked    Boolean           @default(false)
  replies     DiscussionReply[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([groupId])
  @@index([workspaceId])
  @@index([authorId])
  @@index([createdAt])
}

model DiscussionReply {
  id           String     @id @default(cuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  content      String     @db.Text
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([discussionId])
  @@index([authorId])
}

model Event {
  id            String              @id @default(cuid())
  title         String
  description   String              @db.Text
  startDate     DateTime
  endDate       DateTime?
  location      String?
  eventUrl      String?
  imageUrl      String?
  category      String?
  maxAttendees  Int?
  isPublic      Boolean             @default(true)
  creatorId     String
  creator       User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([startDate])
  @@index([creatorId])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("registered")
  registeredAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId])
}

model Challenge {
  id           String                @id @default(cuid())
  title        String
  description  String                @db.Text
  requirements String?               @db.Text
  prize        String?
  startDate    DateTime
  endDate      DateTime
  imageUrl     String?
  category     String?
  status       String                @default("upcoming")
  creatorId    String
  creator      User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  submissions  ChallengeSubmission[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status])
  @@index([endDate])
  @@index([creatorId])
}

model ChallengeSubmission {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  url         String?
  status      String    @default("submitted")
  submittedAt DateTime  @default(now())

  @@unique([challengeId, userId])
  @@index([userId])
  @@index([challengeId])
  @@index([status])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  entityType  String?
  entityId    String?
  title       String?
  description String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

// Analytics Tracking Models

model PageVisit {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path      String
  referrer  String?
  userAgent String?
  ipAddress String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
}

model SearchLog {
  id                String   @id @default(cuid())
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query             String
  resourceType      String?
  resultCount       Int
  clicked           Boolean  @default(false)
  clickedResourceId String?
  providers         String[]
  sessionId         String?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([query])
  @@index([sessionId])
}

model ResourceView {
  id          String     @id @default(cuid())
  resourceId  String
  resource    Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  sessionId   String?
  createdAt   DateTime   @default(now())

  @@index([resourceId])
  @@index([userId])
  @@index([createdAt])
  @@index([sessionId])
}

// Problems & Ideas feed

model ProblemIdeaPost {
  id        String                @id @default(cuid())
  content   String                @db.Text
  imageUrls String[]
  type      String                @default("idea")
  authorId  String
  author    User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  ProblemIdeaComment[]
  likes     ProblemIdeaPostLike[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([type])
}

model ProblemIdeaPostLike {
  id        String          @id @default(cuid())
  postId    String
  post      ProblemIdeaPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model ProblemIdeaComment {
  id        String                   @id @default(cuid())
  postId    String
  post      ProblemIdeaPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  content   String                   @db.Text
  authorId  String
  author    User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     ProblemIdeaCommentLike[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([postId])
  @@index([authorId])
}

model ProblemIdeaCommentLike {
  id        String             @id @default(cuid())
  commentId String
  comment   ProblemIdeaComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

// AI News: user-saved articles
model SavedNews {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url                 String
  title               String
  summary             String?  @db.Text
  source              String?
  category            String?
  imageUrl            String?
  includeInNewsletter Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@unique([userId, url])
  @@index([userId])
  @@index([includeInNewsletter])
}

// Newsletter subscribers
model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  status       String   @default("subscribed")
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
}

// Admin: track external API requests
model ExternalApiRequest {
  id          String   @id @default(cuid())
  provider    String
  category    String
  requestedAt DateTime @default(now())

  @@index([provider, requestedAt])
  @@index([category, requestedAt])
}

// Community Barter
model BarterAsk {
  id            String         @id @default(cuid())
  title         String
  description   String         @db.Text
  whatINeed     String?        @db.Text
  whatIOffer    String?        @db.Text
  status        String         @default("open")
  attachments   Json?
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pitches       BarterPitch[]
  conversations Conversation[] @relation("BarterAskConversations")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model BarterPitch {
  id        String    @id @default(cuid())
  askId     String
  ask       BarterAsk @relation(fields: [askId], references: [id], onDelete: Cascade)
  content   String    @db.Text
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([askId])
  @@index([authorId])
}

// Community Gigs
model Gig {
  id               String         @id @default(cuid())
  title            String
  description      String         @db.Text
  category         String?
  priceFrom        Int?
  priceTo          Int?
  currency         String?        @default("USD")
  deliveryTimeDays Int?
  tags             String[]
  status           String         @default("active")
  authorId         String
  author           User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requests         GigRequest[]
  conversations    Conversation[] @relation("GigConversations")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

model GigRequest {
  id        String   @id @default(cuid())
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  budget    Int?
  status    String   @default("open")
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([gigId])
  @@index([authorId])
}

// Direct messaging
model Conversation {
  id          String     @id @default(cuid())
  gigId       String?
  gig         Gig?       @relation("GigConversations", fields: [gigId], references: [id], onDelete: Cascade)
  barterAskId String?
  barterAsk   BarterAsk? @relation("BarterAskConversations", fields: [barterAskId], references: [id], onDelete: Cascade)

  participants ConversationParticipant[]
  messages     ConversationMessage[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime? @default(now())

  @@index([gigId])
  @@index([barterAskId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("UserConversationParticipants", fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("UserConversationMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// Open Resources page: chat history per search query
model OpenResourcesChat {
  id          String   @id @default(cuid())
  sessionId   String
  searchQuery String
  messages    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionId, searchQuery])
  @@index([sessionId, updatedAt])
}

// Intern Fellowship Program
model InternFellow {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId       String
  track         InternTrack   @relation(fields: [trackId], references: [id], onDelete: Restrict)
  resumeUrl     String?
  resumeParsed  Json?        // Parsed skills, experience from resume
  status        String       @default("active") // active, completed, paused
  xp            Int          @default(0)
  milestonesCompleted Int    @default(0)
  unlockedMilestoneIds Json? @default("[]")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tasks         InternTask[]
  payouts       StipendPayout[]
  paymentDetails InternPaymentDetails?

  @@index([userId])
  @@index([trackId])
  @@index([status])
}

model InternTrack {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String?           @db.Text
  stipendRange String?
  fellows      InternFellow[]
  subTracks    InternSubTrack[]
  milestones   InternMilestone[]
  tasks        InternTask[]

  @@index([slug])
}

model InternSubTrack {
  id          String         @id @default(cuid())
  trackId     String
  track       InternTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?        @db.Text
  order       Int            @default(0)
  milestones  InternMilestone[]

  @@unique([trackId, slug])
  @@index([trackId])
}

model InternMilestone {
  id          String       @id @default(cuid())
  subTrackId  String?
  subTrack    InternSubTrack? @relation(fields: [subTrackId], references: [id], onDelete: Cascade)
  trackId     String
  track       InternTrack   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title       String
  description String?       @db.Text
  dueDate     DateTime?
  stipend     Int?
  order       Int           @default(0)
  status      String        @default("pending")
  highlighted Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tasks       InternTask[]
  payouts     StipendPayout[]

  @@index([trackId])
  @@index([subTrackId])
}

model InternTask {
  id          String       @id @default(cuid())
  trackId     String
  track       InternTrack   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   InternMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  fellowId    String?
  fellow      InternFellow? @relation(fields: [fellowId], references: [id], onDelete: SetNull)
  title       String
  description String?       @db.Text
  stipend     Int?
  status      String        @default("pending")
  progress    Int           @default(0)
  dueDate     DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payouts     StipendPayout[]

  @@index([trackId])
  @@index([milestoneId])
  @@index([fellowId])
  @@index([status])
}

// Affiliate Partnership applications
model PartnershipApplication {
  id           String    @id @default(cuid())
  name         String
  email        String
  linkedin     String?
  coverNote    String?   @db.Text
  status       String    @default("pending") // pending, approved, rejected
  affiliateCode String?  @unique // Generated when approved; partners share this for 5% commission
  reviewedAt   DateTime?
  reviewedBy   String?
  // Payout details
  payoutVpa             String?          // UPI ID e.g. user@upi
  payoutAccountNumber   String?          // Encrypted at application level
  payoutIfsc            String?
  payoutBeneficiaryName String?
  payoutBankName        String?
  razorpayContactId     String?          // Cached Razorpay X Contact ID
  razorpayFundAccountId String?          // Cached Razorpay X Fund Account ID
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  commissions  AffiliateCommission[]
  payouts      AffiliatePayout[]

  @@index([status])
  @@index([email])
  @@index([affiliateCode])
  @@index([createdAt])
}

// Payment history for subscription tracking
model Payment {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Float
  currency          String               @default("INR")
  provider          String               // "razorpay" | "stripe"
  providerPaymentId String               @unique
  providerOrderId   String?
  status            String               @default("pending") // pending, captured, refunded, failed
  plan              String               // "plus" | "enterprise"
  affiliateCode     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  commission        AffiliateCommission?

  @@index([userId])
  @@index([providerPaymentId])
  @@index([status])
}

// Affiliate commission tracking (one per referred payment)
model AffiliateCommission {
  id            String                 @id @default(cuid())
  paymentId     String                 @unique
  payment       Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  affiliateCode String
  partnershipId String
  partnership   PartnershipApplication @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  amount        Float                  // 5% of payment amount
  currency      String                 @default("INR")
  status        String                 @default("pending") // pending, eligible, paid, reversed
  eligibleAt    DateTime               // createdAt + 30 days; payout only allowed after this
  reversedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([affiliateCode])
  @@index([partnershipId])
  @@index([status])
  @@index([eligibleAt])
  @@index([createdAt])
}

// Affiliate payout records via Razorpay X
model AffiliatePayout {
  id                    String                 @id @default(cuid())
  partnershipId         String
  partnership           PartnershipApplication @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  amount                Float
  currency              String                 @default("INR")
  status                String                 @default("pending") // pending, processing, paid, failed
  payoutMethod          String?                // "upi" | "bank_transfer"
  razorpayPayoutId      String?                @unique
  razorpayContactId     String?
  razorpayFundAccountId String?
  transactionRef        String?                // UTR from Razorpay
  initiatedBy           String?                // admin email
  initiatedAt           DateTime?
  paidAt                DateTime?
  failedAt              DateTime?
  failureReason         String?
  notes                 String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([partnershipId])
  @@index([status])
  @@index([createdAt])
}

// Per-generation cost, token usage, and latency tracking
model GenerationLog {
  id               String     @id @default(cuid())
  projectId        String
  project          AppProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId           String
  provider         String     // "openrouter", "groq", "openai", "anthropic"
  model            String     // "google/gemini-2.5-flash", etc.
  stage            String     @default("coder") // "planner", "architect", "coder", "retry"
  status           String     // "completed", "failed", "timeout", "fallback"
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  costUsd          Float?
  costSource       String?    // "openrouter-api", "estimated"
  durationMs       Int
  ttfbMs           Int?       // time-to-first-byte (streaming only)
  filesCreated     Int        @default(0)
  usedFallback     Boolean    @default(false)
  fallbackProvider String?
  fallbackModel    String?
  errorMessage     String?    @db.Text
  generationId     String?    // OpenRouter generation ID for cost lookup
  creditsDeducted  Float?     // credits deducted from user for this generation
  createdAt        DateTime   @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([provider, createdAt])
}

// Intern Stipend Payout tracking
model StipendPayout {
  id              String            @id @default(cuid())
  fellowId        String
  fellow          InternFellow      @relation(fields: [fellowId], references: [id], onDelete: Cascade)
  taskId          String?
  task            InternTask?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  milestoneId     String?
  milestone       InternMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  amount          Int               // Amount in rupees
  currency        String            @default("INR")
  status          String            @default("pending") // pending, processing, paid, failed, cancelled
  paymentMethod   String?           // bank_transfer, upi, razorpay_x
  transactionRef  String?           // UTR or external transaction ID
  approvedBy      String?           // Admin email
  approvedAt      DateTime?
  paidAt          DateTime?
  failedAt        DateTime?
  failureReason   String?
  razorpayPayoutId String?          @unique
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([taskId, fellowId])
  @@unique([milestoneId, fellowId])
  @@index([fellowId])
  @@index([status])
  @@index([createdAt])
}

// Intern bank/UPI details for receiving stipend payouts
model InternPaymentDetails {
  id                String       @id @default(cuid())
  fellowId          String       @unique
  fellow            InternFellow @relation(fields: [fellowId], references: [id], onDelete: Cascade)
  upiId             String?
  bankName          String?
  accountNumber     String?      // Encrypted at application level
  ifscCode          String?
  accountHolderName String?
  razorpayContactId  String?     // Cached Razorpay X Contact ID
  razorpayFundAcctId String?     // Cached Razorpay X Fund Account ID
  isVerified        Boolean      @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}
