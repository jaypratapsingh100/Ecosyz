// Prisma schema for Basic Project Workspace

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                    String      @id @default(cuid())
  supabaseId            String      @unique
  email                 String      @unique
  name                  String?
  avatarUrl             String?
  plan                  Plan        @default(FREE)
  apiKey                String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  workspaces            Workspace[]
  projects              Project[]
  profile               Profile?
  stats                 UserStats?
  achievements          UserAchievement[]
  notifications         Notification[]
  workspaceMemberships  WorkspaceMember[]
  discussions           Discussion[]
  comments              Comment[]
  reactions             Reaction[]
  subscriptionPlan      String?
  subscriptionStatus    String?
  subscriptionStartDate DateTime?
  lastPaymentAmount    Float?
  lastPaymentId        String?
  lastPaymentDate      DateTime?
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  bio         String?  @db.Text
  avatarUrl   String?
  preferences Json?    // { theme: "system"|"light"|"dark", language: "en-IN", emailNotifications: boolean, marketingEmails: boolean }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workspace {
  id          String      @id @default(cuid())
  title       String
  description String?     @db.Text
  ownerId     String
  isPublic    Boolean     @default(false)
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  // Legacy relationships
  resources   Resource[]
  shares      ShareLink[]
  
  // New relationships
  indexedResources WorkspaceResource[]
  members          WorkspaceMember[]
  versions         WorkspaceVersion[]
  discussions      Discussion[]
  
  @@index([ownerId])
  @@index([isPublic])
}

model Resource {
  id          String      @id @default(cuid())
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  title       String
  url         String?
  type        String?
  tags        Json?
  data        Json?
  createdAt   DateTime    @default(now())
  annotations Annotation[]
}

model Annotation {
  id         String   @id @default(cuid())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String
  body       String
  highlights Json?
  createdAt  DateTime @default(now())
}

model ShareLink {
  id          String    @id @default(cuid())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  token       String    @unique
  readOnly    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Project {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  framework      String   @default("react")
  appType        String   @default("web")
  files          Json?
  resources      Json?
  generationData Json?
  status         String   @default("active")
  deploymentUrl  String?
  githubUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ===== NEW MODELS FOR OPEN IDEA MVP =====

// Indexed resources from external sources
model IndexedResource {
  id          String       @id @default(cuid())
  externalId  String       @unique
  type        ResourceType
  title       String
  description String?      @db.Text
  content     String?      @db.Text
  url         String
  source      String
  authors     String[]
  year        Int?
  license     String?
  tags        String[]
  metadata    Json
  embedding   Json?        // Vector stored as JSON
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  // Relationships
  graphNodes  KnowledgeGraphNode[]
  inWorkspaces WorkspaceResource[]
  
  @@index([type])
  @@index([source])
  @@index([year])
}

// Knowledge Graph Models
model KnowledgeGraphNode {
  id         String   @id @default(cuid())
  resourceId String?
  nodeType   String   // Resource, Author, Technology, Concept, Organization
  label      String
  properties Json
  createdAt  DateTime @default(now())
  
  // Relationships
  resource   IndexedResource? @relation(fields: [resourceId], references: [id])
  outgoing   KnowledgeGraphEdge[] @relation("FromNode")
  incoming   KnowledgeGraphEdge[] @relation("ToNode")
  
  @@index([nodeType])
  @@index([resourceId])
}

model KnowledgeGraphEdge {
  id       String   @id @default(cuid())
  type     String   // CITES, AUTHORED_BY, USES, IMPLEMENTS, RELATED_TO, etc.
  fromId   String
  toId     String
  weight   Float    @default(1.0)
  properties Json?
  createdAt DateTime @default(now())
  
  // Relationships
  from     KnowledgeGraphNode @relation("FromNode", fields: [fromId], references: [id])
  to       KnowledgeGraphNode @relation("ToNode", fields: [toId], references: [id])
  
  @@index([fromId])
  @@index([toId])
  @@index([type])
}

// Enhanced Workspace Models
model WorkspaceResource {
  id          String   @id @default(cuid())
  workspaceId String
  resourceId  String
  section     String?  // "Background", "Data", "Code", "References", etc.
  order       Int      @default(0)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  
  // Relationships
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resource    IndexedResource @relation(fields: [resourceId], references: [id])
  
  @@unique([workspaceId, resourceId])
  @@index([workspaceId])
  @@index([section])
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(VIEWER)
  joinedAt    DateTime   @default(now())
  
  // Relationships
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceVersion {
  id          String   @id @default(cuid())
  workspaceId String
  version     Int
  changes     Json     // Description of changes made
  createdBy   String   // User ID
  createdAt   DateTime @default(now())
  
  // Relationships
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@index([workspaceId])
  @@index([version])
}

// Community & Discussion Models
model Discussion {
  id          String   @id @default(cuid())
  workspaceId String?
  resourceId  String?
  title       String
  content     String   @db.Text
  authorId    String
  isPinned    Boolean  @default(false)
  isLocked    Boolean  @default(false)
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationships
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  reactions   Reaction[]
  
  @@index([workspaceId])
  @@index([resourceId])
  @@index([authorId])
  @@index([isPinned])
}

model Comment {
  id           String   @id @default(cuid())
  discussionId String
  parentId     String?  // For threading
  content      String   @db.Text
  authorId     String
  isEdited     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relationships
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent       Comment?   @relation("CommentThread", fields: [parentId], references: [id])
  replies      Comment[]  @relation("CommentThread")
  author       User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions    Reaction[]
  
  @@index([discussionId])
  @@index([parentId])
  @@index([authorId])
}

model Reaction {
  id           String   @id @default(cuid())
  type         String   // thumbs_up, heart, celebrate, etc.
  userId       String
  discussionId String?
  commentId    String?
  createdAt    DateTime @default(now())
  
  // Relationships
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  comment      Comment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  @@unique([userId, discussionId, type])
  @@unique([userId, commentId, type])
  @@index([userId])
  @@index([discussionId])
  @@index([commentId])
}

// Gamification Models
model Achievement {
  id          String   @id @default(cuid())
  type        String   // COLLECTOR, COLLABORATOR, PROTOTYPE_PIONEER, etc.
  name        String
  description String
  icon        String
  points      Int      @default(10)
  createdAt   DateTime @default(now())
  
  // Relationships
  users       UserAchievement[]
  
  @@index([type])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  
  // Relationships
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model UserStats {
  id                    String   @id @default(cuid())
  userId                String   @unique
  totalSearches         Int      @default(0)
  totalWorkspaces       Int      @default(0)
  totalResources        Int      @default(0)
  totalPrototypes       Int      @default(0)
  totalCollaborations   Int      @default(0)
  totalPoints           Int      @default(0)
  level                 Int      @default(1)
  lastActiveAt          DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relationships
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([totalPoints])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // NEW_RESOURCE, COLLABORATION, ACHIEVEMENT, etc.
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  // Relationships
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// Enums
enum Plan {
  FREE
  PRO
  API
  ENTERPRISE
}

enum ResourceType {
  PAPER
  CODE
  DATASET
  MODEL
  VIDEO
  HARDWARE
  DESIGN
  DOCUMENTATION
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}
