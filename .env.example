# Example environment variables for Open Idea workspace
# Use pooler (port 6543) for app runtime; direct (5432) for migrations/db push. Supabase requires sslmode on direct.
DATABASE_URL=
DIRECT_URL=
YOUTUBE_API_KEY=

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: For social logins (configure in Supabase dashboard)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI Providers
# Groq (required for Open Resources chat): free, fast — https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (optional, App Builder only): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Email (Resend) - for contact form, careers applications, newsletter
RESEND_API_KEY=
NEXT_PUBLIC_COMPANY_EMAIL=info@openidea.world
# Newsletter: optional from address and secret for server-to-server send
# NEWSLETTER_FROM_EMAIL=Open Idea <noreply@yourdomain.com>
# NEWSLETTER_SEND_SECRET=optional-secret-for-bearer-auth

# Admin: comma-separated emails that can access /admin and send newsletters
# ADMIN_EMAILS=admin@example.com,other@example.com

# Payment Configuration
NEXT_PUBLIC_UPI_ID=your-business-upi-id@bank
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Optional: self-hosted DeepSeek (App Builder only)
# AZURE_DEEPSEEK_URL=http://your-deepseek-host:8000
