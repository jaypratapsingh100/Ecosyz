# Example environment variables for Open Idea workspace
DATABASE_URL=
YOUTUBE_API_KEY=

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: For social logins (configure in Supabase dashboard)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI Providers (App Builder / Chat)
# OpenRouter (recommended): DeepSeek, GPT-4, etc. — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq (fallback): Llama 3.3 — https://console.groq.com/keys
GROQ_API_KEY=

# Email (Resend) - for contact form, careers applications, etc.
RESEND_API_KEY=
NEXT_PUBLIC_COMPANY_EMAIL=info@openidea.world

# Payment Configuration
NEXT_PUBLIC_UPI_ID=your-business-upi-id@bank
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
AZURE_DEEPSEEK_URL=http://74.225.138.116:8000
